{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {"type": "integer"},
      "price": {"type": "number", "multipleOf": 0.01},
      "rate": {"type": "number", "multipleOf": 0.0001},
      "step": {"type": "number", "multipleOf": 0.1},
      "dose": {"type": "number", "multipleOf": 1e-8}
    },
    "required": ["id"]
  }
}
